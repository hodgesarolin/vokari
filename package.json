{
  "name": "@vokari/epistemic",
  "version": "0.4.0",
  "description": "Epistemic integrity engine for AI assistants — beliefs, predictions, corrections, adversarial verification, calibration dashboard, and context injection via MCP",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "vokari": "dist/cli.js",
    "epistemic": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "dashboard": "tsx src/dashboard.ts",
    "test": "vitest run",
    "import": "tsx src/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hodgesarolin/vokari.git"
  },
  "keywords": [
    "mcp",
    "ai",
    "beliefs",
    "predictions",
    "corrections",
    "calibration",
    "verification",
    "dashboard",
    "epistemology",
    "self-verification"
  ],
  "author": "Daniel Hodges",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hodgesarolin/vokari/issues"
  },
  "homepage": "https://github.com/hodgesarolin/vokari#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "better-sqlite3": "^12.6.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
